{
  "name": "towards-light-editor",
  "displayName": "TowardsLight 博客工具",
  "description": "TowardsLight 博客的文章管理、写作预览与站点配置工具(本地扩展)",
  "version": "0.9.2",
  "private": true,
  "publisher": "towardslight",
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./dist/extension.js",
  "scripts": {
    "build": "node build.mjs",
    "watch": "node build.mjs --watch",
    "test": "node scripts/test-core.mjs",
    "package": "vsce package --no-dependencies --allow-missing-repository --baseImagesUrl https://example.invalid/"
  },
  "contributes": {
    "configuration": {
      "title": "TowardsLight",
      "properties": {
        "towardsLight.devPort": {
          "type": "number",
          "default": 4321,
          "description": "Astro dev server 端口(预览用)"
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "towardsLight",
          "title": "博客",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "towardsLight": [
        {
          "id": "towardsLightPosts",
          "name": "文章"
        },
        {
          "id": "towardsLightConfig",
          "name": "站点配置"
        },
        {
          "id": "towardsLightPreview",
          "name": "预览"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "towardsLightPosts",
        "contents": "还没有文章。\n[新建文章](command:towardsLight.newPost)"
      }
    ],
    "commands": [
      {
        "command": "towardsLight.refreshPosts",
        "title": "刷新文章列表",
        "icon": "$(refresh)"
      },
      {
        "command": "towardsLight.switchProfile",
        "title": "切换档案",
        "icon": "$(folder-opened)"
      },
      {
        "command": "towardsLight.newPost",
        "title": "新建文章",
        "icon": "$(add)"
      },
      {
        "command": "towardsLight.openPostPreview",
        "title": "预览文章",
        "icon": "$(open-preview)"
      },
      {
        "command": "towardsLight.editSiteConfig",
        "title": "编辑站点信息",
        "icon": "$(gear)"
      },
      {
        "command": "towardsLight.addCategory",
        "title": "管理分类",
        "icon": "$(folder)"
      },
      {
        "command": "towardsLight.addLink",
        "title": "管理链接",
        "icon": "$(link)"
      },
      {
        "command": "towardsLight.addIcon",
        "title": "新增 Lucide 图标",
        "icon": "$(symbol-misc)"
      },
      {
        "command": "towardsLight.insertImage",
        "title": "插入正文图片",
        "icon": "$(file-media)"
      },
      {
        "command": "towardsLight.openSiteFile",
        "title": "打开 site.ts"
      },
      {
        "command": "towardsLight.openLinksFile",
        "title": "打开 links.ts"
      },
      {
        "command": "towardsLight.selectTemplateDir",
        "title": "选择模板目录",
        "icon": "$(repo)"
      },
      {
        "command": "towardsLight.startPreview",
        "title": "启动预览",
        "icon": "$(play)"
      },
      {
        "command": "towardsLight.stopServer",
        "title": "停止预览",
        "icon": "$(debug-stop)"
      },
      {
        "command": "towardsLight.showServerLog",
        "title": "查看预览日志",
        "icon": "$(output)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "towardsLight.newPost",
          "when": "view == towardsLightPosts",
          "group": "navigation@1"
        },
        {
          "command": "towardsLight.refreshPosts",
          "when": "view == towardsLightPosts",
          "group": "navigation@2"
        },
        {
          "command": "towardsLight.showServerLog",
          "when": "view == towardsLightPreview",
          "group": "navigation@1"
        }
      ],
      "view/item/context": [
        {
          "command": "towardsLight.openPostPreview",
          "when": "view == towardsLightPosts && viewItem == post",
          "group": "inline"
        },
        {
          "command": "towardsLight.stopServer",
          "when": "view == towardsLightPreview && viewItem == server",
          "group": "inline"
        },
        {
          "command": "towardsLight.showServerLog",
          "when": "view == towardsLightPreview && viewItem == server",
          "group": "inline"
        }
      ],
      "editor/context": [
        {
          "command": "towardsLight.insertImage",
          "when": "editorLangId == markdown",
          "group": "towardsLight"
        }
      ]
    }
  },
  "dependencies": {
    "gray-matter": "^4.0.3",
    "lucide-static": "^1.48.0",
    "ts-morph": "^28.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@types/vscode": "1.85.0",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  }
}
